{
  "name": "@taskpack/server",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Taskpack local server: REST API, SSE and the web UI on 127.0.0.1:4242.",
  "bin": {
    "taskpack-server": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@taskpack/api": "workspace:*",
    "@taskpack/core": "workspace:*",
    "busboy": "^1.6.0",
    "chokidar": "^5.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15"
  }
}
