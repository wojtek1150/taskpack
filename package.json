{
  "name": "taskpack",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @taskpack/server --filter @taskpack/web dev",
    "taskpack": "node packages/cli/dist/index.js",
    "tpk": "node packages/cli/dist/index.js",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "kit:build": "pnpm build && node packages/cli/dist/index.js kit build",
    "start": "pnpm --filter @taskpack/server start",
    "test:e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "kit:mcpb": "pnpm build && node scripts/build-mcpb.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
