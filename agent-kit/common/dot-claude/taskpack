#!/bin/sh
# Taskpack shim, installed by the Taskpack agent kit. Finds Node.js >= 22 and runs taskpack.mjs next
# to it (the Taskpack CLI for this workspace, or the MCP server with --mcp). Hooks, .mcp.json and
# MCP client configs call this file, so they work even when `node` is not on PATH (nvm, fnm,
# volta, asdf and GUI apps started from the Dock or Finder).
#
# Order: $TASKPACK_NODE, `node` on PATH, the path recorded by `taskpack kit update/repair` in
# taskpack-kit.json, then common install locations (skipped with TASKPACK_NODE_DISCOVERY=0).
# The names from before the rename Groove → Taskpack, GROOVE_NODE and GROOVE_NODE_DISCOVERY,
# still work when the new ones are unset.

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tried=""
found=""

# $1 is a usable Node.js >= 22.
usable() {
  [ -n "$1" ] && [ -x "$1" ] || return 1
  "$1" -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' >/dev/null 2>&1
}

try() {
  [ -n "$found" ] && return 0
  [ -n "$1" ] || return 1
  tried="$tried $1"
  if usable "$1"; then found=$1; fi
}

try "${TASKPACK_NODE:-$GROOVE_NODE}"
try "$(command -v node 2>/dev/null)"
try "$(sed -n 's/^ *"node": *"\(.*\)",\{0,1\} *$/\1/p' "$dir/taskpack-kit.json" 2>/dev/null | head -n 1)"

if [ -z "$found" ] && [ "${TASKPACK_NODE_DISCOVERY:-${GROOVE_NODE_DISCOVERY:-1}}" != "0" ]; then
  # nvm: newest-looking versions first (older majors fail the version check anyway).
  for n in $(ls -1d "${NVM_DIR:-$HOME/.nvm}"/versions/node/*/bin/node 2>/dev/null | sort -r); do try "$n"; done
  for n in \
    "$HOME/.volta/bin/node" \
    "${FNM_DIR:-$HOME/.local/share/fnm}/aliases/default/bin/node" \
    "$HOME/Library/Application Support/fnm/aliases/default/bin/node" \
    "$HOME/.asdf/shims/node" \
    "$HOME/.local/share/mise/shims/node" \
    /opt/homebrew/bin/node \
    /usr/local/bin/node \
    /usr/bin/node; do
    try "$n"
  done
fi

if [ -z "$found" ]; then
  echo "taskpack: Node.js 22 or newer not found (tried:${tried:- nothing}). Install Node 22+, or set TASKPACK_NODE=/path/to/node, or run \`pnpm taskpack kit repair\` in the Taskpack repository from a terminal where node works." >&2
  exit 1
fi

exec "$found" "$dir/taskpack.mjs" "$@"
